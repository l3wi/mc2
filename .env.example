# MicroCommandControl — example environment (copy to .env.local; never commit secrets)
# MCC_BIND=127.0.0.1:7443
# MCC_DATA_DIR=~/.mcc
# MCC_API=http://127.0.0.1:7443
# MCC_API_KEY=                 # operator REST bearer (when server auth is enabled)
# MCC_SERVER=https://127.0.0.1:7444
# MCC_JOIN_TOKEN=
# MCC_NODE_NAME=
# MCC_SECRETS_KEY_PATH=
# MCC_NO_AUTH=false
# MCC_OTLP_ENDPOINT=
# RUST_LOG=info
