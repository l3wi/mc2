# MicroCommandControl — example environment (copy to .env.local; never commit secrets)
# MC2_BIND=127.0.0.1:7443
# MC2_DATA_DIR=~/.mc2
# MC2_API=http://127.0.0.1:7443
# MC2_API_KEY=                 # operator REST bearer (when server auth is enabled)
# MC2_CONTEXT=                 # named client context from ~/.mc2/config.toml
# MC2_ALLOW_INSECURE_HTTP=     # allow plaintext http:// for a remote control plane (opt-in)
# MC2_PUBLIC_HOSTNAME=         # publish the control plane through the ingress catalog
# MC2_PUBLIC_TLS_CERT_RESOLVER=le
# MC2_NODE_NAME=
# MC2_SECRETS_KEY_PATH=
# MC2_NO_AUTH=false
# MC2_LIMIT_CPUS=0             # reserve budget: max CPUs (0 = unlimited)
# MC2_LIMIT_MEMORY_MIB=0       # reserve budget: max memory MiB (0 = unlimited)
# MC2_LIMIT_DISK_MIB=0         # reserve budget: max MC2 disk MiB (0 = unlimited)
# MC2_OTLP_ENDPOINT=
# RUST_LOG=info
